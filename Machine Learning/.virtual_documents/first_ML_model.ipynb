    [97,1],[99,1],[101,1],[103,1],[106,1],
    [96,1],[98,1],[100,1],[104,1],[107,1],

    # Bananas (smooth, lighter)
    [110,0],[115,0],[120,0],[125,0],[130,0],
    [112,0],[118,0],[122,0],[128,0],[132,0],
    [114,0],[119,0],[123,0],[129,0],[134,0],

    # Grapes (very light, smooth)
    [5,0],[6,0],[7,0],[8,0],[9,0],
    [5,0],[6,0],[7,0],[8,0],[9,0],
    [6,0],[7,0],[8,0],[9,0],[10,0]
]
labels = [
    # Apples
    "apple","apple","apple","apple","apple",
    "apple","apple","apple","apple","apple",
    "apple","apple","apple","apple","apple",

    # Oranges
    "orange","orange","orange","orange","orange",
    "orange","orange","orange","orange","orange",
    "orange","orange","orange","orange","orange",

    # Bananas
    "banana","banana","banana","banana","banana",
