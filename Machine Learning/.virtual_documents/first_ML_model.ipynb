from sklearn.tree import DecisionTreeClassifier
import matplotlib.pyplot as plt
from sklearn.tree import plot_tree

feature = [
    [150,0],[150,0],[99,1],[99,1]
]
labels = ["apples","apples","orange","orange"]

clt = DecisionTreeClassifier()
fit = clt.fit(feature,labels)
predict = clt.predict([[140,0],[200,1]])
print(f"The Fruit is :",predict)


#preforming the same for big data

features = [
    # Apples (smooth, medium weight)
    [140,0],[145,0],[150,0],[155,0],[160,0],
    [135,0],[142,0],[148,0],[152,0],[158,0],
    [143,0],[147,0],[149,0],[151,0],[157,0],

